diff --git a/airflow/dags/affinity_dag.py b/airflow/dags/affinity_dag.py
new file mode 100644
index 0000000..fafd056
--- /dev/null
+++ b/airflow/dags/affinity_dag.py
@@ -0,0 +1,14 @@
+"""Airflow wrapper for novamart.jobs.affinity (migrated from crontab.txt, Jan 2020)."""
+from datetime import datetime
+
+from airflow import DAG
+from airflow.operators.bash import BashOperator
+
+with DAG(
+    dag_id="affinity",
+    schedule="30 3 * * *",
+    start_date=datetime(2019, 9, 15),
+    catchup=False,
+    tags=["novamart", "daily"],
+) as dag:
+    run = BashOperator(task_id="run", bash_command="python -m novamart.jobs.affinity")
